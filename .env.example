NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_API_URL=

# Background job auth — set to a random secret, pass as x-cron-secret header
CRON_SECRET=

# Supabase service role key — needed by /api/dggi/deadline-alerts to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=

# pg_dump connection string, used by scripts/backup-supabase.sh
SUPABASE_DB_URL=
# Optional override; defaults to the encrypted rclone remote "gdrive-crypt:"
# RCLONE_REMOTE=gdrive-crypt:
# Dockerised Supabase: container name (docker ps) — used instead of SUPABASE_DB_URL
# SUPABASE_DB_CONTAINER=supabase-db

# Google Drive OAuth for the rclone remote — configure on the server only,
# never commit real values here:
#   rclone config update gdrive client_id <id> client_secret <secret>