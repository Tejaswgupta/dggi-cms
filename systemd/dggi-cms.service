[Unit]
Description=DGGI CMS - Next.js app (build + start)
After=network.target

[Service]
Type=simple
User=acer
WorkingDirectory=/home/acer/dggi-cms
Environment=PATH=/opt/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
ExecStartPre=/opt/node/bin/pnpm build
ExecStart=/opt/node/bin/pnpm start
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
